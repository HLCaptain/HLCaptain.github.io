---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import TableOfContents from "@components/content/TableOfContents.astro";
import { formatDate } from "@lib/content";
import type { MarkdownHeading } from "astro";

type Props = {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  eyebrow: string;
  backLabel?: string;
  headings: MarkdownHeading[];
};

const { title, description, publishedAt, updatedAt, tags = [], eyebrow, backLabel, headings } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class:list={["prose-shell", headings.length > 0 && "prose-shell--with-toc"]}>
    <div class="document-content">
      <PageHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
        backLabel={backLabel}
      />
      <slot name="subheader" />
      <div class="document-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>Updated {formatDate(updatedAt)}</span>}
        {tags.length > 0 && <span>{tags.join(" / ")}</span>}
      </div>
      <div class="prose">
        <slot />
        {headings.length > 0 && <TableOfContents headings={headings} variant="mobile" />}
      </div>
    </div>
    {headings.length > 0 && <TableOfContents headings={headings} variant="desktop" />}
  </article>
</BaseLayout>
