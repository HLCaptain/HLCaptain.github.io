---
import ArticleCard from "@components/ArticleCard.astro";
import ArrowIcon from "@components/ArrowIcon.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, getPublishedArticles, getPublishedProjects } from "@lib/content";

const articles = await getPublishedArticles();
const projects = await getPublishedProjects();
const featuredArticles = articles.filter((entry) => entry.data.featured).slice(0, 3);
const featuredProjects = projects.filter((entry) => entry.data.featured).slice(0, 3);
const signalThumbnailSets = {
  article: {
    original: "/visuals/article-preview.svg",
    wide: "/visuals/signal-article-21-9.svg",
    standard: "/visuals/signal-article-4-3.svg",
    square: "/visuals/signal-article-1-1.svg",
    portrait: "/visuals/signal-article-3-4.svg"
  },
  project: {
    original: "/visuals/project-preview.svg",
    wide: "/visuals/signal-project-21-9.svg",
    standard: "/visuals/signal-project-4-3.svg",
    square: "/visuals/signal-project-1-1.svg",
    portrait: "/visuals/signal-project-3-4.svg"
  },
  profile: {
    original: "/visuals/about-preview.svg",
    wide: "/visuals/signal-profile-21-9.svg",
    standard: "/visuals/signal-profile-4-3.svg",
    square: "/visuals/signal-profile-1-1.svg",
    portrait: "/visuals/signal-profile-3-4.svg"
  }
};
const previewItems = [
  ...articles.slice(0, 2).map((article, index) => {
    const images = signalThumbnailSets.article;
    return {
      kind: "Article",
      title: article.data.title,
      description: article.data.description,
      href: `/articles/${article.id}/`,
      meta: formatDate(article.data.publishedAt),
      images,
      mixedImage: index === 0 ? images.wide : images.square,
      mixedLabel: index === 0 ? "21:9" : "1:1"
    };
  }),
  ...projects.slice(0, 1).map((project) => ({
    kind: "Project",
    title: project.data.title,
    description: project.data.description,
    href: `/work/${project.id}/`,
    meta: project.data.status,
    images: signalThumbnailSets.project,
    mixedImage: signalThumbnailSets.project.standard,
    mixedLabel: "4:3"
  })),
  {
    kind: "Profile",
    title: "About HLCaptain",
    description:
      "A compact profile for the work style behind the portfolio: precise interfaces, fast systems, and durable notes.",
    href: "/about/",
    meta: "about",
    images: signalThumbnailSets.profile,
    mixedImage: signalThumbnailSets.profile.portrait,
    mixedLabel: "3:4"
  }
];
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow">Portfolio / writing archive</p>
      <h1 id="home-title">HLCaptain</h1>
      <p>
        A compact personal site for interface craft, software projects, and field notes on building
        fast, legible systems.
      </p>
      <div class="hero-actions">
        <a href="/articles/" class="button-link">Read articles</a>
        <a href="/work/" class="button-link button-link--ghost">View work</a>
      </div>
    </div>

    <div class="preview-feed" data-preview-feed style={`--item-count:${previewItems.length}; --active-index:0`} aria-label="Site preview feed">
      <div class="preview-feed__rail" aria-hidden="true">
        <span data-preview-rail></span>
      </div>
      <div class="preview-feed__items">
        {previewItems.map((item, index) => (
          <article class:list={["preview-feed__item", index === 0 && "is-active"]} data-preview-item data-preview-href={item.href}>
            <button
              class="preview-feed__trigger"
              type="button"
              data-preview-trigger
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <span class="preview-feed__kind">{item.kind}</span>
              <strong>{item.title}</strong>
              <span>{item.meta}</span>
            </button>
            <div class="preview-feed__detail" data-preview-detail>
              <div class="preview-feed__media" data-signal-aspect="16:9">
                <img
                  src={item.images.original}
                  alt=""
                  loading={index === 0 ? "eager" : "lazy"}
                  data-signal-image
                  data-signal-src-original={item.images.original}
                  data-signal-src-wide={item.images.wide}
                  data-signal-src-standard={item.images.standard}
                  data-signal-src-square={item.images.square}
                  data-signal-src-portrait={item.images.portrait}
                  data-signal-src-mixed={item.mixedImage}
                  data-signal-label-original="16:9"
                  data-signal-label-wide="21:9"
                  data-signal-label-standard="4:3"
                  data-signal-label-square="1:1"
                  data-signal-label-portrait="3:4"
                  data-signal-label-mixed={item.mixedLabel}
                />
                <span class="preview-feed__arrow" aria-hidden="true">
                  <ArrowIcon class="arrow-icon--inline" role="link" />
                </span>
              </div>
              <strong class="preview-feed__detail-title">{item.title}</strong>
              <p class="preview-feed__description"><span>{item.description}</span></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="content-band" aria-labelledby="latest-articles">
    <div class="section-heading">
      <p class="eyebrow">Writing</p>
      <h2 id="latest-articles">Latest articles</h2>
      <a href="/articles/">All articles</a>
    </div>
    <div class="entry-grid">
      {featuredArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section class="content-band" aria-labelledby="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Work</p>
      <h2 id="selected-work">Selected projects</h2>
      <a href="/work/">All projects</a>
    </div>
    <div class="entry-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
