---
import ArticleCard from "@components/ArticleCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SemanticIcon from "@components/SemanticIcon.astro";
import Signal from "@components/Signal.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, getEntryIcon, getPublishedArticles, getPublishedProjects } from "@lib/content";

const articles = await getPublishedArticles();
const projects = await getPublishedProjects();
const hasArticles = articles.length > 0;
const featuredArticles = articles.filter((entry) => entry.data.featured).slice(0, 3);
const featuredProjects = projects.filter((entry) => entry.data.featured).slice(0, 3);
const thumbnailImages = (src: string) => ({ square: src, landscape: src, wide: src, portrait: src });
const profileImages = thumbnailImages("/visuals/github-profile-avatar.jpg");
const previewItems = [
  ...articles.slice(0, 2).map((article) => ({
    kind: "Article",
    title: article.data.title,
    description: article.data.description,
    href: `/articles/${article.id}/`,
    meta: formatDate(article.data.publishedAt),
    ...(article.data.thumbnail
      ? { images: thumbnailImages(article.data.thumbnail.src) }
      : { icon: getEntryIcon("article", article.id) })
  })),
  ...projects.slice(0, 3 - Math.min(articles.length, 2)).map((project) => ({
    kind: "Project",
    title: project.data.title,
    description: project.data.description,
    href: `/work/${project.id}/`,
    meta: project.data.status,
    ...(project.data.thumbnail
      ? { images: thumbnailImages(project.data.thumbnail.src) }
      : { icon: getEntryIcon("project", project.id) })
  })),
  {
    kind: "Profile",
    title: "About HLCaptain",
    description:
      "Android engineering across payment terminals, mobile banking, airline booking, and product-minded side projects.",
    href: "/about/",
    meta: "about",
    images: profileImages
  }
];
---

<BaseLayout>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow">Portfolio / project archive</p>
      <h1 id="home-title">HLCaptain</h1>
      <p>
        A compact personal site for interface craft, software projects, and field notes on building
        fast, legible systems.
      </p>
      <div class="hero-actions">
        {hasArticles && (
          <span class="button-link-group hover-group">
            <a href="/articles/" class="button-link hover-group__target">Read articles</a>
          </span>
        )}
        <span class="button-link-group hover-group">
          <a href="/work/" class="button-link button-link--ghost hover-group__target">
            <SemanticIcon name="work" />
            View projects
          </a>
        </span>
      </div>
    </div>

    <Signal items={previewItems} />
  </section>

  {featuredArticles.length > 0 && (
    <section class="content-band" aria-labelledby="latest-articles">
      <div class="section-heading">
        <p class="eyebrow">Writing</p>
        <h2 id="latest-articles">Latest articles</h2>
        <a href="/articles/">All articles</a>
      </div>
      <div class="entry-grid">
        {featuredArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}

  <section class="content-band" aria-labelledby="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Work</p>
      <h2 id="selected-work">Selected projects</h2>
      <a href="/work/">All projects</a>
    </div>
    <div class="entry-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
