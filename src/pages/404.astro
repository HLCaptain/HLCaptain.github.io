---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="The requested page was not found.">
  <section class="empty-state">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The route is not in the current archive.</p>
    <span class="button-link-group hover-group">
      <a href="/" class="button-link hover-group__target">Return home</a>
    </span>
  </section>
</BaseLayout>
