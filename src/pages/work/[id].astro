---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import ExternalLinkIcon from "@components/ExternalLinkIcon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<MarkdownLayout
  eyebrow={project.data.status}
  title={project.data.title}
  description={project.data.description}
  publishedAt={project.data.publishedAt}
  updatedAt={project.data.updatedAt}
  tags={project.data.tags}
>
  <Fragment slot="subheader">
    {project.data.links.length > 0 && (
      <nav class="link-strip" aria-label="Project links">
        {project.data.links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
            <ExternalLinkIcon />
          </a>
        ))}
      </nav>
    )}
  </Fragment>
  <Content />
</MarkdownLayout>
