---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import ExternalLinkIcon from "@components/ExternalLinkIcon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<MarkdownLayout
  eyebrow={project.data.status}
  title={project.data.title}
  description={project.data.description}
  backLabel="Back"
  publishedAt={project.data.publishedAt}
  updatedAt={project.data.updatedAt}
  tags={project.data.tags}
  headings={headings}
>
  <Fragment slot="subheader">
    {project.data.links.length > 0 && (
      <nav class="link-strip" aria-label="Project links">
        {project.data.links.map((link) => (
          <span class="link-strip__item hover-group">
            <a class="hover-group__target" href={link.href} target="_blank" rel="noreferrer">
              {link.label}
              <ExternalLinkIcon />
            </a>
          </span>
        ))}
      </nav>
    )}
  </Fragment>
  <Content />
</MarkdownLayout>
