---
import { getCollection, render } from "astro:content";
import ExternalLinkButton from "@components/ExternalLinkButton.astro";
import DetailLayout from "@layouts/DetailLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<DetailLayout
  eyebrow={project.data.status}
  title={project.data.title}
  description={project.data.description}
  backLabel="Back"
  publishedAt={project.data.publishedAt}
  updatedAt={project.data.updatedAt}
  tags={project.data.tags}
  headings={headings}
  prose
>
  <Fragment slot="actions">
    {project.data.links.length > 0 && (
      <nav class="link-strip" aria-label="Project links">
        {project.data.links.map((link) => (
          <ExternalLinkButton href={link.href}>{link.label}</ExternalLinkButton>
        ))}
      </nav>
    )}
  </Fragment>
  <Content />
</DetailLayout>
