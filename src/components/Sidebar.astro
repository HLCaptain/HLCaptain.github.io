---
import { siteConfig } from "../site.config";
import { getPublishedArticles, getPublishedProjects, stripTrailingSlash } from "@lib/content";
import { Icon } from "astro-icon/components";
import SidebarRow from "./SidebarRow.astro";

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const normalizedPath = stripTrailingSlash(currentPath);

type NavigationItem = {
  label: string;
  href: string;
  glyph: string;
  external?: true;
};

const isExternal = (item: NavigationItem) => item.external === true;

const isActive = (item: NavigationItem) => {
  if (isExternal(item)) return false;
  return normalizedPath === stripTrailingSlash(item.href);
};

const [articles, projects] = await Promise.all([getPublishedArticles(), getPublishedProjects()]);
const articleItems = articles.map((article) => ({
  label: article.data.title,
  href: `/articles/${article.id}/`,
  glyph: "writing"
}));
const projectItems = projects.map((project) => ({
  label: project.data.title,
  href: `/work/${project.id}/`,
  glyph: "work"
}));

let navIndex = 0;
const navigation = siteConfig.navigation
  .filter((group) => group.label !== "Articles" || articles.length > 0)
  .map((group) => ({
    ...group,
    items: (group.label === "Articles"
      ? [group.items[0], ...articleItems, ...group.items.slice(1)]
      : group.label === "Projects"
        ? [group.items[0], ...projectItems]
        : group.items
    ).map((item) => ({
      ...item,
      navIndex: navIndex++
    }))
  }));
---

<button
  class="mobile-menu-button sidebar-action-button"
  type="button"
  data-sidebar-open
  aria-controls="site-sidebar"
  aria-expanded="false"
  aria-label="Open navigation"
>
  <span class="menu-icon mobile-menu-button__icon mobile-menu-button__icon--open" aria-hidden="true">
    <Icon name="lucide:menu" />
  </span>
  <span class="menu-icon mobile-menu-button__icon mobile-menu-button__icon--close" aria-hidden="true">
    <Icon name="lucide:x" />
  </span>
  <span class="sr-only" data-sidebar-toggle-label>Open navigation</span>
</button>

<div class="sidebar-backdrop" data-sidebar-close></div>

<aside id="site-sidebar" class="site-sidebar" data-sidebar>
  <div class="sidebar-panel">
    <header class="sidebar-header">
      <button class="sidebar-toggle sidebar-action-button" type="button" data-sidebar-collapse aria-label="Collapse sidebar" aria-pressed="false">
        <span class="menu-icon" aria-hidden="true">
          <Icon name="lucide:menu" />
        </span>
      </button>
    </header>

    <nav class="sidebar-nav" aria-label="Primary navigation">
      {navigation.map((group) => (
        <details class="nav-group" open={group.open} data-nav-group={group.label}>
          <SidebarRow type="group" label={group.label} glyph={group.glyph} />
          <div class="nav-items">
            {group.items.map((item) => (
              <SidebarRow
                type="link"
                label={item.label}
                glyph={item.glyph}
                href={item.href}
                active={isActive(item)}
                external={isExternal(item)}
                navIndex={item.navIndex}
              />
            ))}
          </div>
        </details>
      ))}
    </nav>

    <section class="accent-panel" aria-label="Appearance controls">
      <div class="surface-controls">
        <button class="surface-control surface-control--theme" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
          <span class="surface-control__icon surface-control__icon--light" aria-hidden="true">
            <Icon name="lucide:sun" />
          </span>
          <span class="surface-control__icon surface-control__icon--dark" aria-hidden="true">
            <Icon name="lucide:moon" />
          </span>
          <span class="surface-control__icon surface-control__icon--system" aria-hidden="true">
            <Icon name="lucide:monitor" />
          </span>
          <span class="surface-control__label" data-theme-label>Light</span>
        </button>

        <label class="surface-control surface-control--accent">
          <span class="surface-control__swatch" data-accent-preview aria-hidden="true"></span>
          <span class="surface-control__label">Accent</span>
          <input type="color" value="#b9843b" aria-label="Custom accent color" data-accent-input />
        </label>

        <button class="surface-control surface-control--reset" type="button" data-accent-reset aria-label="Reset accent to auto" title="Reset accent to auto">
          <Icon name="lucide:rotate-ccw" aria-hidden="true" />
        </button>
      </div>

    </section>
  </div>
</aside>
