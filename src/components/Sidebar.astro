---
import { siteConfig, type NavItem } from "../site.config";
import { stripTrailingSlash } from "@lib/content";
import { Icon } from "astro-icon/components";
import SidebarRow from "./SidebarRow.astro";

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const normalizedPath = stripTrailingSlash(currentPath);

const isExternal = (item: NavItem) => "external" in item && item.external === true;

const isActive = (item: NavItem) => {
  if (isExternal(item)) return false;
  const href = stripTrailingSlash(item.href);
  if (href === "/") return normalizedPath === "/";
  return normalizedPath === href || normalizedPath.startsWith(`${href}/`);
};

let navIndex = 0;
const navigation = siteConfig.navigation.map((group) => ({
  ...group,
  items: group.items.map((item) => ({
    ...item,
    navIndex: navIndex++
  }))
}));
---

<button class="mobile-menu-button" type="button" data-sidebar-open aria-controls="site-sidebar" aria-expanded="false">
  <span class="menu-icon" aria-hidden="true">
    <Icon name="lucide:menu" />
  </span>
  <span class="sr-only">Open navigation</span>
</button>

<div class="sidebar-backdrop" data-sidebar-close></div>

<aside id="site-sidebar" class="site-sidebar" data-sidebar>
  <div class="sidebar-panel">
    <header class="sidebar-brand">
      <button class="sidebar-toggle" type="button" data-sidebar-collapse aria-label="Collapse sidebar" aria-pressed="false">
        <span class="menu-icon" aria-hidden="true">
          <Icon name="lucide:menu" />
        </span>
      </button>
      <a href="/" class="brand-mark" aria-label={`${siteConfig.name} home`}>
        <span class="brand-symbol" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </span>
        <span class="brand-copy">
          <strong>{siteConfig.name}</strong>
          <small>portfolio / notes</small>
        </span>
      </a>
    </header>

    <nav class="sidebar-nav" aria-label="Primary navigation">
      {navigation.map((group) => (
        <details class="nav-group" open={group.open} data-nav-group>
          <SidebarRow type="group" label={group.label} glyph={group.glyph} />
          <div class="nav-items">
            {group.items.map((item) => (
              <SidebarRow
                type="link"
                label={item.label}
                glyph={item.glyph}
                href={item.href}
                active={isActive(item)}
                external={isExternal(item)}
                navIndex={item.navIndex}
              />
            ))}
          </div>
        </details>
      ))}
    </nav>

    <section class="accent-panel" aria-labelledby="accent-title">
      <div>
        <p id="accent-title">Surface</p>
        <button type="button" data-accent-reset>Auto</button>
      </div>
      <div class="theme-switch" aria-label="Theme">
        <button type="button" data-theme-value="light" aria-pressed="true">Light</button>
        <button type="button" data-theme-value="black" aria-pressed="false">Black</button>
      </div>
      <div class="accent-controls">
        <input type="color" value="#b9843b" aria-label="Custom accent color" data-accent-input />
        <div class="accent-swatches" aria-label="Accent presets">
          {siteConfig.accentPresets.map((preset) => (
            <button
              type="button"
              title={preset.label}
              aria-label={`${preset.label} accent`}
              style={`--swatch:${preset.value}`}
              data-accent-value={preset.value}
            ></button>
          ))}
        </div>
      </div>
    </section>
  </div>
</aside>
