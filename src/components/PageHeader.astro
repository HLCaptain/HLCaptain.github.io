---
import { Icon } from "astro-icon/components";

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  backHref?: string;
  backLabel?: string;
};

const { eyebrow, title, description, backHref, backLabel } = Astro.props;
---

<header class="page-header">
  {backHref && backLabel && (
    <a class="page-header__back" href={backHref}>
      <span class="page-header__back-icon" aria-hidden="true"><Icon name="lucide:arrow-left" /></span>
      <span>{backLabel}</span>
    </a>
  )}
  <div class="page-header__title-row">
    <h1>{title}</h1>
    <p class="eyebrow">{eyebrow}</p>
  </div>
  <p>{description}</p>
</header>
