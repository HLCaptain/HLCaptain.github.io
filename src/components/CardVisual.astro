---
import SemanticIcon from "./SemanticIcon.astro";
import { getEntryIcon } from "@lib/content";

type Props = {
  kind: "article" | "project";
  visualKey: string;
};

const { kind, visualKey } = Astro.props;
const visual = visualKey === "proto-shape" || visualKey === "spliteasy" ? visualKey : kind;
const icon = getEntryIcon(kind, visualKey);
---

<span class="entry-card__visual" data-card-visual={visual} aria-hidden="true">
  <span class="entry-card__visual-static">
    <SemanticIcon name={icon} />
  </span>
  <svg
    class="entry-card__visual-motion"
    viewBox="0 0 48 36"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >
    {visual === "proto-shape" && (
      <g class="card-scene__cube">
        <path class="card-scene__cube-face card-scene__cube-face--left" d="m24 5v14l-12-7 12-7Z" fill="currentColor" fill-opacity=".14" />
        <path class="card-scene__cube-face card-scene__cube-face--right" d="m24 5 12 7-12 7V5Z" fill="currentColor" fill-opacity=".14" />
        <path class="card-scene__cube-face card-scene__cube-face--left" d="m12 12 12 7v12l-12-7V12Z" fill="currentColor" fill-opacity=".05" />
        <path class="card-scene__cube-face card-scene__cube-face--right" d="m24 19 12-7v12l-12 7V19Z" fill="currentColor" fill-opacity=".09" />
      </g>
    )}
    {visual === "spliteasy" && (
      <>
        <g class="card-scene__part" style="--part: 0">
          <circle cx="24" cy="9" r="5" fill="currentColor" fill-opacity=".1" />
          <path d="M21.5 7.5h5m-5 3h5" />
        </g>
        <path class="card-scene__draw" style="--part: 1" d="M24 14v10M24 19H12v5M24 19h12v5" />
        <g class="card-scene__part card-scene__share" style="--part: 2; --part-x: 12px; --part-y: -19px">
          <circle cx="12" cy="28" r="4" fill="currentColor" fill-opacity=".08" />
          <path d="M10.5 28h3" />
        </g>
        <g class="card-scene__part card-scene__share" style="--part: 2; --part-x: 0px; --part-y: -19px">
          <circle cx="24" cy="28" r="4" fill="currentColor" fill-opacity=".08" />
          <path d="M22.5 28h3" />
        </g>
        <g class="card-scene__part card-scene__share" style="--part: 2; --part-x: -12px; --part-y: -19px">
          <circle cx="36" cy="28" r="4" fill="currentColor" fill-opacity=".08" />
          <path d="M34.5 28h3" />
        </g>
      </>
    )}
    {visual === "article" && (
      <>
        <path class="card-scene__draw" style="--part: 0" d="M6 7h36v23H6V7Z" />
        <path class="card-scene__draw card-scene__typed" style="--part: 1" d="M11 13h17" />
        <path class="card-scene__draw card-scene__typed" style="--part: 2" d="M11 18h25" />
        <path class="card-scene__draw card-scene__typed" style="--part: 3" d="M11 23h13" />
        <path class="card-scene__part" style="--part: 4" d="M28 22v3" />
      </>
    )}
    {visual === "project" && (
      <>
        <g class="card-scene__part" style="--part: 0">
          <path d="m7 20 7-4 7 4-7 4-7-4Z" fill="currentColor" fill-opacity=".08" />
          <path d="M7 20v7l7 4 7-4v-7M14 24v7" />
        </g>
        <g class="card-scene__part" style="--part: 1">
          <path d="m20 13 7-4 7 4-7 4-7-4Z" fill="currentColor" fill-opacity=".08" />
          <path d="M20 13v7l7 4 7-4v-7M27 17v7" />
        </g>
        <g class="card-scene__part" style="--part: 2">
          <path d="m30 23 6-3 6 3-6 3-6-3Z" fill="currentColor" fill-opacity=".08" />
          <path d="M30 23v5l6 3 6-3v-5M36 26v5" />
        </g>
      </>
    )}
  </svg>
</span>

<style>
  .entry-card__visual {
    --semantic-icon-size: 26px;
    display: inline-grid;
    width: 48px;
    height: 36px;
    place-items: center;
    color: currentColor;
  }

  .entry-card__visual-static,
  .entry-card__visual-motion {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    transition:
      opacity 140ms var(--ease),
      transform 180ms var(--ease);
  }

  .entry-card__visual-static {
    display: grid;
    place-items: center;
  }

  .entry-card__visual-motion {
    opacity: 0;
    transform: scale(0.92);
  }

  .card-scene__part {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .card-scene__cube {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .card-scene__cube-face {
    transform-box: fill-box;
  }

  .card-scene__cube-face--left {
    transform-origin: right center;
  }

  .card-scene__cube-face--right {
    transform-origin: left center;
  }

  .card-scene__draw {
    stroke-dasharray: 96;
    stroke-dashoffset: 96;
  }

  :global(.entry-card__link:focus-visible) .entry-card__visual-static {
    opacity: 0;
    transform: scale(0.82);
  }

  :global(.entry-card__link:focus-visible) .entry-card__visual-motion {
    opacity: 1;
    transform: scale(1);
  }

  :global(.entry-card__link:focus-visible) .card-scene__part {
    animation: card-scene-part-in 620ms var(--ease) calc(var(--part) * 70ms) both;
  }

  :global(.entry-card__link:focus-visible) .card-scene__draw {
    animation: card-scene-draw 520ms var(--ease) calc(var(--part) * 70ms) both;
  }

  :global(.entry-card__link:focus-visible) .card-scene__cube {
    animation: card-scene-cube-reveal 700ms var(--ease) both;
  }

  :global(.entry-card__link:focus-visible) .card-scene__cube-face--left {
    animation: card-scene-cube-face-turn 700ms var(--ease) both;
  }

  :global(.entry-card__link:focus-visible) .card-scene__cube-face--right {
    animation: card-scene-cube-face-turn 700ms var(--ease) reverse both;
  }

  @media (hover: hover) {
    :global(.entry-card__link:hover) .entry-card__visual-static {
      opacity: 0;
      transform: scale(0.82);
    }

    :global(.entry-card__link:hover) .entry-card__visual-motion {
      opacity: 1;
      transform: scale(1);
    }

    :global(.entry-card__link:hover) .card-scene__part {
      animation: card-scene-part-in 620ms var(--ease) calc(var(--part) * 70ms) both;
    }

    :global(.entry-card__link:hover) .card-scene__draw {
      animation: card-scene-draw 520ms var(--ease) calc(var(--part) * 70ms) both;
    }

    :global(.entry-card__link:hover) .card-scene__cube {
      animation: card-scene-cube-reveal 700ms var(--ease) both;
    }

    :global(.entry-card__link:hover) .card-scene__cube-face--left {
      animation: card-scene-cube-face-turn 700ms var(--ease) both;
    }

    :global(.entry-card__link:hover) .card-scene__cube-face--right {
      animation: card-scene-cube-face-turn 700ms var(--ease) reverse both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-card__visual-static {
      opacity: 1 !important;
      transform: none !important;
    }

    .entry-card__visual-motion {
      opacity: 0 !important;
      transform: none !important;
    }

    .entry-card__visual-motion * {
      animation: none !important;
    }
  }

  @keyframes card-scene-part-in {
    0% {
      opacity: 0;
      transform: translate(var(--part-x, 0), var(--part-y, 7px)) scale(0.92);
    }
    72% {
      opacity: 1;
      transform: translateY(-1px) scale(1);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes card-scene-draw {
    from {
      stroke-dashoffset: 96;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes card-scene-cube-reveal {
    0% {
      opacity: 0;
      transform: scale(0.76);
    }
    20%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes card-scene-cube-face-turn {
    0%,
    50%,
    100% {
      transform: scaleX(1);
    }
    25% {
      transform: scaleX(0.08);
    }
    75% {
      transform: scaleX(1.92);
    }
  }
</style>
