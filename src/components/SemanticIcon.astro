type IconName = keyof (typeof iconSources)["tabler"];

type Props = {
  name: IconName | string;
  class?: string;
  inline?: boolean;
};

const requestedName = Astro.props.name as IconName;
const name = requestedName in iconSources.tabler ? requestedName : "link";
const className = ["semantic-icon", Astro.props.class].filter(Boolean).join(" ");
const { inline = false } = Astro.props;
---

<span class={className} data-icon-name={name} aria-hidden="true">
  {Object.entries(iconSources).map(([style, icons]) => (
    inline ? (
      <Icon name={icons[name]} class="semantic-icon__svg" data-icon-style={style} is:inline />
    ) : (
      <Icon name={icons[name]} class="semantic-icon__svg" data-icon-style={style} />
    )
  ))}
</span>
