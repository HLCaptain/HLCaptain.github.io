---
import ArrowIcon from "./ArrowIcon.astro";

type SignalImages = {
  square: string;
  landscape: string;
  wide: string;
  portrait: string;
};

type SignalItem = {
  kind: string;
  title: string;
  description: string;
  href: string;
  meta: string;
  images: SignalImages;
};

interface Props {
  items: SignalItem[];
  label?: string;
}

const { items, label = "Site preview signal" } = Astro.props;
---

<div
  class="signal"
  data-signal
  style={`--signal-item-count:${Math.max(items.length, 1)}; --signal-segment-size:${100 / Math.max(items.length, 1)}%; --active-index:0; --active-progress:0%`}
  aria-label={label}
>
  <div class="signal__track" aria-hidden="true">
    <span class="signal__marker" data-signal-marker></span>
  </div>

  <div class="signal__items">
    {items.map((item, index) => {
      const panelId = `signal-panel-${index}`;
      const triggerId = `signal-trigger-${index}`;
      const active = index === 0;

      return (
        <article
          class:list={["signal__item", active && "is-active"]}
          data-signal-item
          data-signal-href={item.href}
        >
          <button
            id={triggerId}
            class="signal__summary"
            type="button"
            data-signal-trigger
            aria-controls={panelId}
            aria-expanded={active}
          >
            <span class="signal__topline">
              <span class="signal__kind">{item.kind}</span>
              <span class="signal__meta">{item.meta}</span>
            </span>
            <strong class="signal__title">{item.title}</strong>
          </button>

          <div
            id={panelId}
            class="signal__panel"
            data-signal-panel
            role="region"
            aria-labelledby={triggerId}
            aria-hidden={!active}
            inert={!active}
          >
            <div class="signal__content">
              <div class="signal__media" data-signal-aspect="1:1">
                <img
                  src={item.images.square}
                  alt=""
                  loading={active ? "eager" : "lazy"}
                  width="640"
                  height="640"
                  data-signal-image
                  data-signal-src-square={item.images.square}
                  data-signal-src-landscape={item.images.landscape}
                  data-signal-src-wide={item.images.wide}
                  data-signal-src-portrait={item.images.portrait}
                  data-signal-label-square="1:1"
                  data-signal-label-landscape="4:3"
                  data-signal-label-wide="16:9"
                  data-signal-label-portrait="3:4"
                />
                <a
                  class="signal__media-action"
                  href={item.href}
                  data-signal-link
                  aria-label={`Open ${item.kind.toLowerCase()}: ${item.title}`}
                >
                  <ArrowIcon class="arrow-icon--inline" aria-hidden="true" />
                </a>
              </div>

              <div class="signal__copy">
                <p>{item.description}</p>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .signal {
    --signal-summary-height: 3.75rem;
    --signal-panel-height: 16.5rem;
    --signal-item-gap: 0.25rem;
    --signal-shell-space: 0.5rem;
    --signal-panel-space: 0.5rem;
    --signal-content-gap: 0.375rem;
    --signal-media-size: 5rem;
    --signal-compact-media-limit: 10rem;
    --signal-aspect: 1 / 1;
    --signal-copy-lines: 6;
    position: relative;
    display: grid;
    grid-template-columns: 0.625rem minmax(0, 1fr);
    column-gap: 0.875rem;
    align-self: center;
    inline-size: 100%;
    min-inline-size: 0;
    padding: var(--signal-shell-space);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    container: signal / inline-size;
  }

  .signal__track {
    position: relative;
    min-block-size: 100%;
  }

  .signal__track::before {
    position: absolute;
    inset: 0 auto 0 50%;
    inline-size: 2px;
    background: color-mix(in srgb, var(--ink) 11%, transparent);
    content: "";
    transform: translateX(-50%);
  }

  .signal__marker {
    position: absolute;
    top: var(--active-progress);
    left: 50%;
    inline-size: 0.5rem;
    block-size: var(--signal-segment-size);
    background: var(--accent-readable);
    border: 2px solid var(--surface);
    transform: translateX(-50%);
    transition:
      top 400ms var(--ease),
      block-size 220ms var(--ease),
      background-color 180ms var(--ease);
  }

  .signal__items {
    display: flex;
    flex-direction: column;
    gap: var(--signal-item-gap);
    min-inline-size: 0;
    block-size: calc(
      var(--signal-item-count) * var(--signal-summary-height) + var(--signal-panel-height) +
        (var(--signal-item-count) - 1) * var(--signal-item-gap)
    );
  }

  .signal__item {
    position: relative;
    display: grid;
    grid-template-rows: var(--signal-summary-height) minmax(0, 1fr);
    flex: 0 0 auto;
    min-inline-size: 0;
    block-size: var(--signal-summary-height);
    overflow: hidden;
    background: var(--panel-bg);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    cursor: pointer;
    transition:
      block-size 400ms var(--ease),
      background-color 220ms var(--ease),
      border-color 220ms var(--ease),
      box-shadow 220ms var(--ease),
      transform 220ms var(--ease);
  }

  .signal__item.is-active {
    block-size: calc(var(--signal-summary-height) + var(--signal-panel-height));
    background: color-mix(in srgb, var(--surface-soft) 88%, transparent);
    border-color: color-mix(in srgb, var(--accent-readable) 48%, var(--line));
    box-shadow: 0 1rem 2.75rem color-mix(in srgb, var(--ink) 9%, transparent);
  }

  .signal__item:hover {
    z-index: 2;
    background: var(--surface-soft);
    border-color: var(--line-strong);
    box-shadow: 0 1.125rem 3rem color-mix(in srgb, var(--ink) 12%, transparent);
    transform: translateY(-0.25rem);
  }

  .signal__summary {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto auto;
    row-gap: 0.125rem;
    align-content: center;
    inline-size: 100%;
    block-size: var(--signal-summary-height);
    min-inline-size: 0;
    padding: 0.375rem 0.5rem;
    color: var(--ink);
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background-color 180ms var(--ease);
  }

  .signal__summary:focus-visible,
  .signal__media-action:focus-visible {
    outline: 2px solid var(--accent-readable);
    outline-offset: -3px;
  }

  .signal__topline {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    min-inline-size: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .signal__kind,
  .signal__meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .signal__meta {
    text-align: right;
  }

  .signal__title {
    display: -webkit-box;
    min-inline-size: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
    padding-block-end: 0.12em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .signal__panel {
    min-inline-size: 0;
    min-block-size: 0;
    padding: 0 var(--signal-panel-space) var(--signal-panel-space);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition:
      opacity 180ms var(--ease),
      transform 280ms var(--ease);
  }

  .signal__item.is-active .signal__panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 80ms;
  }

  .signal__content {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--signal-content-gap);
    align-items: stretch;
    min-inline-size: 0;
    block-size: 100%;
    padding-block-start: 0.125rem;
  }

  .signal__media {
    position: relative;
    align-self: center;
    justify-self: center;
    inline-size: min(100%, var(--signal-media-size));
    max-block-size: 100%;
    aspect-ratio: var(--signal-aspect);
    overflow: hidden;
    background: color-mix(in srgb, var(--surface-strong) 54%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
    transition: border-color 180ms var(--ease);
  }

  .signal__media::after {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: none;
    min-inline-size: 2.25rem;
    padding: 0.25rem 0.375rem;
    color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent) 88%, var(--surface) 12%);
    border: 1px solid color-mix(in srgb, var(--ink) 24%, transparent);
    content: attr(data-signal-aspect);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1;
    text-align: center;
  }

  :global(:root:not([data-signal-ratio="square"])) .signal__media::after {
    display: block;
  }

  .signal__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .signal__media-action {
    position: absolute;
    z-index: 3;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    place-items: center;
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transform: translateX(0.875rem);
    transition:
      opacity 180ms var(--ease),
      transform 220ms var(--ease),
      background-color 180ms var(--ease),
      color 180ms var(--ease);
  }

  .signal__media-action :global(.arrow-icon) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    color: var(--accent-ink);
  }

  .signal__item.is-active:hover .signal__media-action,
  .signal__item.is-active .signal__media:focus-within .signal__media-action {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .signal__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-inline-size: 0;
    min-block-size: 0;
    padding: 0.5rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--surface-soft) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    transition:
      background-color 180ms var(--ease),
      border-color 180ms var(--ease);
  }

  .signal__item:hover .signal__media,
  .signal__item:hover .signal__copy {
    border-color: var(--line-strong);
  }

  .signal__item:hover .signal__copy {
    background: color-mix(in srgb, var(--panel-hover) 82%, transparent);
  }

  .signal__copy p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.48;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--signal-copy-lines);
  }

  :global(:root[data-signal-layout="stack"]) .signal {
    --signal-panel-height: 18rem;
    --signal-media-size: 6rem;
    --signal-copy-lines: 6;
  }

  :global(:root[data-signal-layout="compact"]) .signal {
    --signal-panel-height: 10.75rem;
    --signal-media-size: 5rem;
    --signal-copy-lines: 6;
  }

  :global(:root[data-signal-layout="compact"]) .signal__content {
    grid-template-columns: minmax(5.75rem, 0.72fr) minmax(0, 1.28fr);
    grid-template-rows: minmax(0, 1fr);
  }

  :global(:root[data-signal-layout="compact"]) .signal__copy {
    padding: 0.625rem;
  }

  :global(:root[data-signal-layout="compact"]) .signal__media img {
    object-fit: contain;
  }

  :global(:root[data-signal-ratio="landscape"]) .signal {
    --signal-aspect: 4 / 3;
    --signal-media-size: 6.5rem;
  }

  :global(:root[data-signal-ratio="wide"]) .signal {
    --signal-aspect: 16 / 9;
    --signal-media-size: 8.5rem;
  }

  :global(:root[data-signal-ratio="portrait"]) .signal {
    --signal-aspect: 3 / 4;
    --signal-media-size: 3.75rem;
  }

  :global(:root[data-signal-layout="compact"][data-signal-ratio="portrait"]) .signal {
    --signal-compact-media-limit: 7.5rem;
  }

  @container signal (min-width: 22rem) {
    .signal__content {
      grid-template-columns: minmax(8rem, 0.88fr) minmax(0, 1.12fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .signal__media {
      inline-size: 100%;
    }

    :global(:root[data-signal-layout="stack"]) .signal__content {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    :global(:root[data-signal-layout="stack"]) .signal__media {
      inline-size: min(100%, var(--signal-media-size));
    }

    :global(:root[data-signal-layout="compact"]) .signal__content {
      grid-template-columns: minmax(7.5rem, min(36%, var(--signal-compact-media-limit))) minmax(0, 1fr);
    }

    :global(:root[data-signal-layout="compact"]) .signal__media {
      inline-size: min(100%, var(--signal-compact-media-limit));
    }
  }

  @media (min-width: 1041px) {
    :global(:root[data-signal-layout="split"]) .signal__content {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    :global(:root[data-signal-layout="split"]) .signal__media {
      inline-size: fit-content;
      max-inline-size: 100%;
      block-size: 100%;
    }

    :global(:root[data-signal-layout="split"]) .signal__media img {
      inline-size: auto;
      max-inline-size: 100%;
      block-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal__marker,
    .signal__item,
    .signal__panel,
    .signal__media-action {
      transition-duration: 1ms;
      transition-delay: 0ms;
    }
  }

  @media (hover: none) {
    .signal__item.is-active .signal__media-action {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
  }
</style>
