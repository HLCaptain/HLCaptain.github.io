---
import SemanticIcon from "./SemanticIcon.astro";

type Props = {
  class?: string;
  role?: string;
};

const { role } = Astro.props;
const className = ["arrow-icon", Astro.props.class].filter(Boolean).join(" ");
---

<span class={className} data-arrow-role={role} aria-hidden="true">
  <SemanticIcon name="arrowRight" />
</span>
