---
import ExternalLinkIcon from "./ExternalLinkIcon.astro";
import SemanticIcon from "./SemanticIcon.astro";

type Props = {
  type: "group" | "link";
  label: string;
  glyph: string;
  href?: string;
  active?: boolean;
  external?: boolean;
  navIndex?: number;
};

const { type, label, glyph, href = "#", active = false, external = false, navIndex } = Astro.props;
const iconClass = ["sidebar-row__icon", type === "group" ? "nav-group__icon" : "nav-item__icon"].join(" ");
const labelClass = ["sidebar-row__label", type === "group" ? "nav-group__label" : "nav-item__label"].join(" ");
---

{type === "group" ? (
  <summary class="sidebar-row sidebar-row--group hover-group">
    <span class="sidebar-row__content hover-group__target">
      <span class={iconClass}>
        <SemanticIcon name={glyph} />
        <SemanticIcon name="chevron" class="group-toggle-icon" />
      </span>
      <span class={labelClass}>{label}</span>
    </span>
  </summary>
) : (
  <a
    href={href}
    class:list={["sidebar-row", "sidebar-row--item", "nav-item", "hover-group", active && "is-active"]}
    aria-label={label}
    aria-current={active ? "page" : undefined}
    target={external ? "_blank" : undefined}
    rel={external ? "noreferrer" : undefined}
    data-nav-index={external ? undefined : navIndex}
  >
    <span class="sidebar-row__content hover-group__target">
      <span class={iconClass}>
        <SemanticIcon name={glyph} />
      </span>
      <span class={labelClass}>{label}</span>
      {external && <ExternalLinkIcon />}
    </span>
  </a>
)}
