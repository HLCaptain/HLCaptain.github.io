---
type FactLink = {
  label: string;
  href: string;
  external?: boolean;
};

type Fact = {
  label: string;
  value?: string;
  links?: readonly FactLink[];
};

type Props = {
  items: readonly Fact[];
  label?: string;
};

const { items, label = "Project facts" } = Astro.props;
---

<dl class="detail-facts project-facts" aria-label={label}>
  {items.map((item) => (
    <div class="detail-facts__item project-facts__item">
      <dt>{item.label}</dt>
      <dd>
        {item.value}
        {item.links && (
          <ul class="detail-facts__links">
            {item.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .detail-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    width: 100%;
    gap: 1px;
    margin: 1.75rem 0;
    padding: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .detail-facts__item {
    min-width: 0;
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--surface-soft);
  }

  dt {
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    min-width: 0;
    margin: 0;
    color: var(--ink);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .detail-facts__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 721px) and (max-width: 1040px) {
    .detail-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
