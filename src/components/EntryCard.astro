---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getEntryIcon } from "@lib/content";
import ArrowIcon from "./ArrowIcon.astro";
import SemanticIcon from "./SemanticIcon.astro";

type MetaItem = {
  label: string;
  datetime?: string;
};

type Props = {
  href: string;
  ariaLabel: string;
  kind: "article" | "project";
  visualKey: string;
  title: string;
  description: string;
  tags: string[];
  meta: MetaItem[];
  thumbnail?: ImageMetadata;
};

const { href, ariaLabel, kind, visualKey, title, description, tags, meta, thumbnail } = Astro.props;
const icon = getEntryIcon(kind, visualKey);
---

<article class:list={["entry-card", kind === "project" && "entry-card--project"]}>
  <a href={href} class="entry-card__link" aria-label={ariaLabel}>
    {thumbnail ? (
      <Image class="entry-card__thumbnail" src={thumbnail} alt="" />
    ) : (
      <span class="entry-card__glyph"><SemanticIcon name={icon} /></span>
    )}
    <span class="entry-card__meta">
      {meta.map((item) =>
        item.datetime ? <time datetime={item.datetime}>{item.label}</time> : <span>{item.label}</span>
      )}
    </span>
    <h2>{title}</h2>
    <p>{description}</p>
    {tags.length > 0 && (
      <span class="tag-row" aria-label="Tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </span>
    )}
    <ArrowIcon class="entry-card__arrow" role="card" />
  </a>
</article>
