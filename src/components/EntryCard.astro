---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ArrowIcon from "./ArrowIcon.astro";
import PixelGlyph from "./PixelGlyph.astro";

type MetaItem = {
  label: string;
  datetime?: string;
};

type Props = {
  href: string;
  ariaLabel: string;
  glyph: string;
  title: string;
  description: string;
  tags: string[];
  meta: MetaItem[];
  thumbnail?: ImageMetadata;
  project?: boolean;
};

const { href, ariaLabel, glyph, title, description, tags, meta, thumbnail, project = false } = Astro.props;
---

<article class:list={["entry-card", project && "entry-card--project"]}>
  <a href={href} class="entry-card__link" aria-label={ariaLabel}>
    {thumbnail ? (
      <Image class="entry-card__thumbnail" src={thumbnail} alt="" />
    ) : (
      <span class="entry-card__glyph"><PixelGlyph name={glyph} /></span>
    )}
    <span class="entry-card__meta">
      {meta.map((item) =>
        item.datetime ? <time datetime={item.datetime}>{item.label}</time> : <span>{item.label}</span>
      )}
    </span>
    <h2>{title}</h2>
    <p>{description}</p>
    {tags.length > 0 && (
      <span class="tag-row" aria-label="Tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </span>
    )}
    <ArrowIcon class="entry-card__arrow" role="card" />
  </a>
</article>
